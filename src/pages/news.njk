<h2>Summit updates</h2>

{# byLocale: the collection holds both the en and zh build of every post. #}
{% set posts = collections.news | byLocale(locale) %}
{% if posts.length %}
{#- href is post.data.basePath, NOT post.url.

    basePath is locale-free ("/news/slug/"); post.url on a zh-locale post is
    already "/zh/news/slug/". The i18n transform keys translations on the exact
    source fragment extracted from the ENGLISH build, so a zh page emitting a
    different href produces a fragment that never matches and silently falls
    back to English. Emitting the locale-free path keeps both builds identical
    at translation time, and the localeLinks transform (which runs AFTER i18n)
    adds the /zh prefix. -#}
<ul class="classes">
{% for post in posts %}
  <li class="class-row">
    <span class="class-row__code"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></span>
    <span class="class-row__name"><a href="{{ post.data.basePath }}">{{ post.data.title }}</a></span>
    <p>{{ post.data.description }}</p>
  </li>
{% endfor %}
</ul>
{% else %}
<p>Venue, programme, speaker, registration, exhibition and partnership announcements will be published here as they are approved.</p>
{% endif %}

<h2>Media enquiries</h2>

<p>Journalists seeking comment, accreditation or approved facts should use the Media and Press page.</p>

<p class="section-action"><a class="btn btn--ghost" href="/media/">Media and press</a></p>

{% from "components/image-grid.njk" import grid %}
<aside class="rail">
  {{ grid([
    {src:"/img/plates/tea-field-highland-landscape", alt:"A tea field in the foreground with highland country beyond."}
  ], "", "", "(min-width: 64rem) 300px, 100vw") }}
  <div class="rail__card">
    <p class="label">Announcements as they are confirmed</p>
    <p>Register your interest to receive programme, venue and speaker announcements.</p>
    <p><a class="btn btn--ghost" href="/registration/">Register interest</a></p>
  </div>
</aside>
