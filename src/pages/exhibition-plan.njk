---
layout: layouts/page.njk
basePath: /exhibition-plan/
title: Exhibition floor plan
heading: Exhibition floor plan
standfirst: Interactive floor plan for the International Tea & Technology Expo. Browse stands across two pavilions.
description: Interactive exhibition floor plan for the Kenya-China Tea Summit 2027. Browse available stands across two pavilions.
sitemapPriority: 0.8
hideCta: true
pageStyles:
  - /css/exhibition.css
pageScripts:
  - /js/exhibition/plan-2d.js
---

<div id="exhibition-root" class="exhibition-plan">
  {# The manifest is injected as a JSON text node inside a hidden element.
     The JS module reads it from the DOM. This avoids a network fetch, works
     offline, and does not violate script-src because it is not a script. #}
  <script id="booth-manifest" type="application/json">{{ booths | dump | safe }}</script>

  {# User-facing strings declared in the DOM so the i18n transform can localize them.
     The JS module reads them from this element instead of hardcoding English literals. #}
  <ul id="plan-strings" hidden>
    <li data-key="planLabel">Exhibition floor plan</li>
    <li data-key="stand">Stand</li>
    <li data-key="loadError">The floor plan could not be loaded.</li>
    <li data-key="available">Available</li>
    <li data-key="held">On hold</li>
    <li data-key="booked">Booked</li>
    <li data-key="blocked">Not available</li>
  </ul>

  {# SVG plan container — the JS module renders into this #}
  <div id="plan-container" role="application" aria-label="Exhibition floor plan">
    <noscript>
      <p>This interactive floor plan requires JavaScript.</p>
    </noscript>
  </div>

  {# Controls bar #}
  <div class="plan-controls" id="plan-controls">
    <fieldset class="plan-controls__group">
      <legend class="visually-hidden">Filter by hall</legend>
      <button class="plan-controls__btn plan-controls__btn--active" data-hall="all" type="button" id="btn-hall-all">All halls</button>
      {% for hall in booths.halls %}
      <button class="plan-controls__btn" data-hall="{{ hall.id }}" type="button" id="btn-hall-{{ hall.id }}">{{ hall.name }}</button>
      {% endfor %}
    </fieldset>
    <button class="plan-controls__btn plan-controls__btn--3d" type="button" id="btn-3d-view" aria-label="Open 3D view">3D view</button>
  </div>

  {# Booth detail panel #}
  <aside id="booth-panel" class="booth-panel" hidden aria-label="Stand details">
    <div class="booth-panel__header">
      <h2 class="booth-panel__title" id="panel-title">Stand —</h2>
      <button class="booth-panel__close" id="panel-close" type="button" aria-label="Close panel">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
          <line x1="4" y1="4" x2="14" y2="14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <line x1="14" y1="4" x2="4" y2="14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <dl class="booth-panel__info">
      <div class="booth-panel__row">
        <dt>Location</dt>
        <dd id="panel-zone">—</dd>
      </div>
      <div class="booth-panel__row">
        <dt>Dimensions</dt>
        <dd id="panel-size">—</dd>
      </div>
      <div class="booth-panel__row">
        <dt>Status</dt>
        <dd id="panel-status">—</dd>
      </div>
    </dl>
  </aside>

  {# Legend #}
  <div class="plan-legend" id="plan-legend">
    <span class="plan-legend__item"><span class="plan-legend__swatch" data-status="available"></span> Available</span>
    <span class="plan-legend__item"><span class="plan-legend__swatch" data-status="held"></span> On hold</span>
    <span class="plan-legend__item"><span class="plan-legend__swatch" data-status="booked"></span> Booked</span>
    <span class="plan-legend__item"><span class="plan-legend__swatch" data-status="blocked"></span> Not available</span>
  </div>
</div>

{# 3D view container — three.js renders into this, loaded only on demand #}
<div id="three-container" class="three-container" hidden></div>
