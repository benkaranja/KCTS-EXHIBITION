{# Registration of interest.

   Schema of record is the client's Tally form (FACTS.md §1b), with one
   deliberate omission: the logo/deck FILE UPLOAD is not here. Uploads need
   object storage, type and size validation, and a virus policy, and none of
   that belongs on a public unauthenticated endpoint. It moves to the delegate
   portal, where the person is already known. Client decision, 2026-08-23.

   Category and Participation type are two separate axes on purpose. A tea
   producer can also be an exhibitor; the V2 single list forced people to
   choose between describing themselves and describing what they want.

   Turnstile renders only when a real site key is configured — the test key
   1x00000000000000000000AA must never ship (criterion B6). #}
<form class="form sheet" id="registration-form" method="post" action="/api/register" novalidate>
  <div class="form__head">
    <h2 id="form-heading">Registration of interest</h2>
  </div>

  {# Not "shared with nobody": Brevo sends the email and Cloudflare serves and
     rate-limits the request. Both are processors. The privacy notice names
     them, so this line must not contradict it. #}
  <p class="form__intro">Required fields are marked. Your details are used to contact you about the summit, and are never sold. Our email and hosting providers handle them on our behalf — see the <a href="/privacy/">privacy notice</a>.</p>

  <div class="form__grid">
    <p class="form__row">
      <label class="label" for="reg-name">Full name <span class="req" aria-hidden="true">*</span></label>
      <input class="input" id="reg-name" name="name" type="text" required autocomplete="name" maxlength="120">
    </p>

    <p class="form__row">
      <label class="label" for="reg-email">Email <span class="req" aria-hidden="true">*</span></label>
      <input class="input" id="reg-email" name="email" type="email" required autocomplete="email" maxlength="180">
    </p>

    {# type="tel" not "text": it brings up the phone keypad on mobile and is
       the only input type that does. No pattern attribute — international
       numbering is too varied for a regex that does not reject someone. #}
    <p class="form__row">
      <label class="label" for="reg-phone">Mobile number, with country code <span class="req" aria-hidden="true">*</span></label>
      <input class="input" id="reg-phone" name="phone" type="tel" required autocomplete="tel" maxlength="32" placeholder="+254 111 491 076">
    </p>

    <p class="form__row">
      <label class="label" for="reg-org">Organisation <span class="req" aria-hidden="true">*</span></label>
      <input class="input" id="reg-org" name="organisation" type="text" required autocomplete="organization" maxlength="160">
    </p>

    <p class="form__row">
      <label class="label" for="reg-title">Job title <span class="req" aria-hidden="true">*</span></label>
      <input class="input" id="reg-title" name="jobTitle" type="text" required autocomplete="organization-title" maxlength="120">
    </p>

    <p class="form__row">
      <label class="label" for="reg-country">Country or region <span class="req" aria-hidden="true">*</span></label>
      <input class="input" id="reg-country" name="country" type="text" required autocomplete="country-name" maxlength="80">
    </p>

    <p class="form__row form__row--full">
      <label class="label" for="reg-category">Category <span class="req" aria-hidden="true">*</span></label>
      <select class="input" id="reg-category" name="category" required>
        <option value="">Select one</option>
        {% for c in summit.registrationCategories %}
        <option value="{{ c.slug }}">{{ c.name }}</option>
        {% endfor %}
      </select>
    </p>
  </div>

  {# Checkboxes, not a second select: these are additive to the category and a
     delegate can tick both. A fieldset because a group of related checkboxes
     needs one accessible name, which the legend supplies. #}
  <fieldset class="form__fieldset">
    <legend class="label">Participation type</legend>
    <p class="form__hint">Optional. Leave both unticked to attend only.</p>
    {% for t in summit.participationTypes %}
    <p class="form__check">
      <input class="check" id="reg-part-{{ t.slug }}" name="participation" type="checkbox" value="{{ t.slug }}">
      <label for="reg-part-{{ t.slug }}">{{ t.name }} <span class="form__check-note">{{ t.blurb }}</span></label>
    </p>
    {% endfor %}
  </fieldset>

  <p class="form__row form__row--full">
    <label class="label" for="reg-website">Website</label>
    <input class="input" id="reg-website" name="website" type="url" autocomplete="url" maxlength="200" placeholder="https://">
  </p>

  <p class="form__row form__row--full">
    <label class="label" for="reg-message">Brief description of interest</label>
    <textarea class="input" id="reg-message" name="message" rows="4" maxlength="2000"></textarea>
  </p>

  {# Honeypot: visually hidden, never announced, never focusable. A bot fills it. #}
  <div class="hp" aria-hidden="true">
    <label for="reg-company-url">Company website</label>
    <input id="reg-company-url" name="companyUrl" type="text" tabindex="-1" autocomplete="off">
  </div>
  <input type="hidden" name="formType" value="registration">
  <input type="hidden" name="renderedAt" value="">

  {% if turnstileSiteKey %}
  <div class="cf-turnstile" data-sitekey="{{ turnstileSiteKey }}" data-theme="light"></div>
  {% endif %}

  <button class="btn btn--primary btn--block" type="submit">Register your interest</button>

  {# Live region: announced to screen readers on both success and failure. #}
  <p class="form__status" id="registration-form-status" role="status" aria-live="polite"></p>

  <p class="form__legal">By submitting you agree the Secretariat may use your information to process your registration and contact you with updates about the {{ summit.name }}. Your information is shared with official event partners only as needed for registration and logistics, and is never sold. To review, correct or delete your information, email <a href="mailto:{{ summit.contact.email }}">{{ summit.contact.email }}</a>. See our <a href="/privacy/">privacy notice</a>.</p>
</form>
