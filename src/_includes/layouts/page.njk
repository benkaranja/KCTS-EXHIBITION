---
layout: layouts/base.njk
---
<section class="doc-head">
  {#- Page hero.

      An <img>, not a CSS background. The CSP is `style-src 'self'` with no
      unsafe-inline, so a style="background-image:..." attribute is silently
      dropped — which is exactly what happened on the first attempt and is why
      the band rendered flat green. A real element also gets object-fit,
      decoding and fetchpriority, none of which a background offers.

      alt="" plus aria-hidden on the wrapper: it repeats nothing the heading
      does not already say, so assistive tech should skip it entirely. -#}
  {%- if hero %}
  <div class="doc-head__bg" aria-hidden="true">
    <img src="/img/heroes/{{ hero }}.avif" alt=""
         width="1400" height="525" decoding="async" fetchpriority="high">
  </div>
  {%- endif %}
  <div class="wrap">
    <h1>{{ heading or title }}</h1>
    {% if standfirst %}<p class="doc-head__standfirst">{{ standfirst }}</p>{% endif %}
  </div>
</section>

<section class="section">
  <div class="wrap">
    {% if translationStatus == "machine" %}
    <div class="mt-notice" role="note" lang="zh-Hans">
      <p><strong>本页面为机器翻译，尚未经过人工审核。</strong>如有疑问，请以<a href="{{ basePath }}" lang="en" hreflang="en" data-nolocale>英文原版</a>为准。</p>
    </div>
    {% endif %}
    {#- Two-column grid when the page supplies an <aside class="rail">, plain
        block when it does not. See .doc-body in style.css. The machine
        translation notice stays outside so it always spans full width. -#}
    <div class="doc-body">
      {{ content | safe }}
    </div>
  </div>
</section>

{% if not hideCta %}
<section class="section section--tint cta-close">
  <div class="wrap">
    <h2>{{ ctaHeading or "Register your interest" }}</h2>
    <p class="lede">{{ ctaBody or "Six categories, from delegate to exhibitor. Fees and deadlines are published once the secretariat confirms them." }}</p>
    <p class="section-action">
      <a class="btn btn--primary" href="{{ ctaUrl or '/registration/' }}">{{ ctaLabel or "Register interest" }}</a>
    </p>
  </div>
</section>
{% endif %}
