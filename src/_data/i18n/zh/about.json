  "strings": {
    "About the summit | Kenya-China Tea Summit": "关于峰会 | 肯尼亚-中国茶叶峰会",
    "<span class=\"visually-hidden\">Menu</span>\n      <span class=\"site-nav__bars\" aria-hidden=\"true\"></span>": "<span class=\"visually-hidden\">菜单</span>\n      <span class=\"site-nav__bars\" aria-hidden=\"true\"></span>",
    "<a href=\"/about/\" aria-current=\"page\">About</a>": "<a href=\"/about/\" aria-current=\"page\">关于</a>",
